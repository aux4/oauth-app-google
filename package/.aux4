{
  "scope": "aux4",
  "name": "oauth-app-google",
  "version": "0.0.7",
  "description": "Google provider plugin for aux4/oauth-app. Adds a `google` command and the /google/* OAuth routes; holds your Google client id/secret so your CLI tools never have to.",
  "license": "MIT",
  "tags": [
    "oauth",
    "google",
    "auth",
    "cloud",
    "plugin"
  ],
  "dependencies": [
    "aux4/oauth-app"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "oauth-app",
      "commands": [
        {
          "name": "google",
          "execute": [
            "profile:oauth-app:google"
          ],
          "help": {
            "text": "Google OAuth provider"
          }
        }
      ]
    },
    {
      "name": "oauth-app:google",
      "commands": [
        {
          "name": "authorize-url",
          "execute": [
            "set:base=nvl(brokerPublicUrl, cloudVmUrl)",
            "set:redirectUri=!echo -n ${base}/api/google/callback",
            "set:scopes=${query.scopes}",
            "set:scopes=nvl(scopes, googleScopes)",
            "set:state=${query.state}",
            "set:clientId=${googleClientId}",
            "if(base==) && echo \"Error: this broker's public URL is not set — provide BROKER_PUBLIC_URL, or deploy on aux4.cloud which injects AUX4_CLOUD_VM_URL\" 1>&2 && exit 1 || if(base!=) && true",
            "if(clientId==) && echo \"Error: google has no client credentials configured\" 1>&2 && exit 1 || true",
            "aux4 oauth authorize-url --provider google --clientId value(clientId) param(redirectUri) param(scopes) param(state) --authUrl https://accounts.google.com/o/oauth2/v2/auth --configFile ${packageDir}/providers.yaml"
          ],
          "help": {
            "text": "Build the Google authorization URL (server-side, credentials held by this app)",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query — redirectUri, scopes, state",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body (unused here)",
                "default": "{}"
              },
              {
                "name": "googleClientId",
                "text": "Google OAuth client id",
                "env": "GOOGLE_CLIENT_ID",
                "default": ""
              },
              {
                "name": "googleClientSecret",
                "text": "Google OAuth client secret",
                "env": "GOOGLE_CLIENT_SECRET",
                "default": ""
              },
              {
                "name": "googleScopes",
                "text": "Default scopes (space or comma separated) used when the request does not specify any; falls back to the bundled Google default",
                "env": "GOOGLE_SCOPES",
                "default": ""
              },
              {
                "name": "brokerPublicUrl",
                "text": "This broker's own public base URL (e.g. https://host/oauth-broker/api); the redirect URI is <brokerPublicUrl>/callback and must be registered on the Google app",
                "env": "BROKER_PUBLIC_URL",
                "default": ""
              },
              {
                "name": "cloudVmUrl",
                "text": "The machine's own public base URL, injected automatically by aux4.cloud (AUX4_CLOUD_VM_URL). Used when BROKER_PUBLIC_URL is not set, so a hosted broker needs no URL config",
                "env": "AUX4_CLOUD_VM_URL",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "exchange",
          "execute": [
            "set:code=${body.code}",
            "set:codeVerifier=${body.codeVerifier}",
            "set:base=nvl(brokerPublicUrl, cloudVmUrl)",
            "set:redirectUri=!echo -n ${base}/api/google/callback",
            "set:clientId=${googleClientId}",
            "set:clientSecret=${googleClientSecret}",
            "if(base==) && echo \"Error: this broker's public URL is not set — provide BROKER_PUBLIC_URL, or deploy on aux4.cloud which injects AUX4_CLOUD_VM_URL\" 1>&2 && exit 1 || if(base!=) && true",
            "if(clientId==) && echo \"Error: google has no client credentials configured\" 1>&2 && exit 1 || true",
            "aux4 oauth exchange --provider google --clientId value(clientId) --clientSecret value(clientSecret) param(code) param(codeVerifier) param(redirectUri) --includeTokens true --tokenUrl https://oauth2.googleapis.com/token --userinfoUrl https://openidconnect.googleapis.com/v1/userinfo --configFile ${packageDir}/providers.yaml"
          ],
          "help": {
            "text": "Exchange an authorization code for tokens (server-side, credentials held by this app)",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params (unused here)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body — code, codeVerifier (redirectUri is fixed to this broker's callback)",
                "default": "{}"
              },
              {
                "name": "googleClientId",
                "text": "Google OAuth client id",
                "env": "GOOGLE_CLIENT_ID",
                "default": ""
              },
              {
                "name": "googleClientSecret",
                "text": "Google OAuth client secret",
                "env": "GOOGLE_CLIENT_SECRET",
                "default": ""
              },
              {
                "name": "brokerPublicUrl",
                "text": "This broker's own public base URL; the redirect URI (<brokerPublicUrl>/callback) must match the one used at authorize time",
                "env": "BROKER_PUBLIC_URL",
                "default": ""
              },
              {
                "name": "cloudVmUrl",
                "text": "The machine's own public base URL, injected automatically by aux4.cloud (AUX4_CLOUD_VM_URL). Used when BROKER_PUBLIC_URL is not set, so a hosted broker needs no URL config",
                "env": "AUX4_CLOUD_VM_URL",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "refresh",
          "execute": [
            "set:refreshToken=${body.refreshToken}",
            "set:clientId=${googleClientId}",
            "set:clientSecret=${googleClientSecret}",
            "if(refreshToken==) && echo \"Error: refreshToken is required\" 1>&2 && exit 1 || true",
            "if(clientId==) && echo \"Error: google has no client credentials configured\" 1>&2 && exit 1 || true",
            "aux4 oauth refresh --provider google --clientId value(clientId) --clientSecret value(clientSecret) param(refreshToken) --tokenUrl https://oauth2.googleapis.com/token --configFile ${packageDir}/providers.yaml"
          ],
          "help": {
            "text": "Renew an access token from a refresh token (server-side, credentials held by this app)",
            "variables": [
              {
                "name": "params",
                "text": "Path params (from the api runtime)",
                "default": "{}"
              },
              {
                "name": "query",
                "text": "Query params (unused here)",
                "default": "{}"
              },
              {
                "name": "body",
                "text": "Request body — refreshToken",
                "default": "{}"
              },
              {
                "name": "googleClientId",
                "text": "Google OAuth client id",
                "env": "GOOGLE_CLIENT_ID",
                "default": ""
              },
              {
                "name": "googleClientSecret",
                "text": "Google OAuth client secret",
                "env": "GOOGLE_CLIENT_SECRET",
                "default": ""
              }
            ]
          }
        }
      ]
    }
  ]
}
